---
// Encadrés du cours, utilisables directement dans les fichiers .mdx :
//   <Bloc type="definition" titre="Discriminant"> … </Bloc>
// (laisser une ligne vide après la balise ouvrante et avant la balise fermante)
import { rendreMarkdownEnLigne } from '../lib/markdown';
interface Props {
  type:
    | 'definition'
    | 'propriete'
    | 'theoreme'
    | 'methode'
    | 'exemple'
    | 'remarque'
    | 'attention'
    | 'demonstration';
  titre?: string;
}
const { type, titre } = Astro.props;

const labels: Record<Props['type'], string> = {
  definition: 'Définition',
  propriete: 'Propriété',
  theoreme: 'Théorème',
  methode: 'Méthode',
  exemple: 'Exemple',
  remarque: 'Remarque',
  attention: 'Attention',
  demonstration: 'Démonstration',
};
const label = labels[type];
if (!label) {
  throw new Error(`<Bloc type="${type}"> : type inconnu. Types possibles : ${Object.keys(labels).join(', ')}.`);
}
// Le titre peut contenir une formule : titre="Suite $(\mathrm{e}^{an})$".
const titreHtml = titre ? await rendreMarkdownEnLigne(titre) : undefined;
---

{
  type === 'demonstration' ? (
    <details class="bloc bloc--demonstration">
      <summary>
        {label}
        {titreHtml && <Fragment set:html={` — ${titreHtml}`} />}
      </summary>
      <div class="bloc-contenu">
        <slot />
      </div>
    </details>
  ) : (
    <div class={`bloc bloc--${type}`}>
      <p class="bloc-label">
        {label}
        {titreHtml && <span set:html={` — ${titreHtml}`} />}
      </p>
      <div class="bloc-contenu">
        <slot />
      </div>
    </div>
  )
}
