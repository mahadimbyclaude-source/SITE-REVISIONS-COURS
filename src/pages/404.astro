---
import Base from '../layouts/Base.astro';
---

<Base titre="Page introuvable">
  <section class="bientot">
    <p class="surtitre">Erreur 404</p>
    <h1>Page introuvable</h1>
    <p class="chapeau">Cette page n’existe pas ou a été déplacée. Tu peux utiliser la recherche ou repartir de l’accueil.</p>
    <div class="actions">
      <a class="bouton" href="/">Retour à l’accueil</a>
      <button type="button" class="bouton bouton--contour" data-ouvrir-recherche>Rechercher</button>
    </div>
  </section>
</Base>
