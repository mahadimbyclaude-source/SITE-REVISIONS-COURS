---
// Page d'une matière dans une classe (ex. /premiere/maths/) : chapitre mis en avant,
// puis la liste numérotée des chapitres, générée depuis la collection et triée par `ordre`.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import BientotDisponible from '../../../components/BientotDisponible.astro';
import Fil from '../../../components/Fil.astro';
import EncartEnAvant from '../../../components/EncartEnAvant.astro';
import { CLASSES, MATIERES, miseEnAvant, urlChapitre, urlClasse, type Classe, type Matiere } from '../../../lib/catalogue';
import { chapitresDe } from '../../../lib/contenu';

export const getStaticPaths = (() =>
  CLASSES.flatMap((classe) =>
    MATIERES.map((matiere) => ({
      params: { classe: classe.slug, matiere: matiere.slug },
      props: { classe, matiere },
    })),
  )) satisfies GetStaticPaths;

const { classe, matiere } = Astro.props as { classe: Classe; matiere: Matiere };
const chapitres = await chapitresDe(classe.slug, matiere.slug);
const titre = `${matiere.nom} · ${classe.nom}`;
const enAvant = chapitres.filter((c) => miseEnAvant(c));
---

<Base titre={titre}>
  <Fil elements={[{ nom: classe.nom, url: urlClasse(classe.slug) }, { nom: matiere.court }]} />
  {
    chapitres.length > 0 ? (
      <>
        <section class="intro">
          <h1>{titre}</h1>
        </section>

        {enAvant.map((c) => (
          <EncartEnAvant chapitre={c} />
        ))}

        <h2 class="section-titre">
          Chapitres de {classe.nom} · {matiere.court}
        </h2>
        <ol class="chapitres-compacts">
          {chapitres.map((c) => {
            const info = miseEnAvant(c);
            return (
              <li>
                <a
                  class:list={['chapitre-compact', { 'chapitre-compact--en-avant': info }]}
                  href={urlChapitre(c.classe, c.matiere, c.slug)}
                >
                  <span class="chapitre-numero" aria-hidden="true">
                    {c.numero}
                  </span>
                  <span class="chapitre-compact-titre">
                    <span class="sr-only">Chapitre {c.numero} : </span>
                    {c.titre}
                  </span>
                  {info && <span class="etiquette etiquette--epreuve">Sans calculatrice</span>}
                </a>
              </li>
            );
          })}
        </ol>
      </>
    ) : (
      <BientotDisponible
        titre={titre}
        retour={{ nom: `Retour à ${classe.nom}`, url: urlClasse(classe.slug) }}
        annales={matiere.slug === 'maths'}
      />
    )
  }
</Base>
